{
  "name": "al-najaf-hardware-rental",
  "version": "1.0.0",
  "description": "Offline desktop management application for hardware inventory, rentals, sales, and invoices.",
  "author": "Al Najaf Hardware & Tools Rental",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "electron": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "jspdf": "^4.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.7",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "build": {
    "appId": "com.alnajaf.hardware.rental",
    "productName": "Al Najaf Hardware Rental",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
